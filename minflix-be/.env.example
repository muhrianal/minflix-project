# Copy to .env to override docker compose defaults (dev only).
# If you change MINIO_PORT, also set STORAGE_PUBLIC_ENDPOINT / STORAGE_PLAYLIST_BASE_URL for the api.
API_PORT=8080
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
